{
  "permissions": {
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(sed -i*)",
      "Bash(git checkout*)",
      "Bash(git clean*)",
      "Edit(/sdevpy/**/*.py)",
      "Edit(/scripts/**/*.py)",
      "Edit(/sdevpy/**/*.ipynb)",
      "NotebookEdit(**)",
      "Write(/sdevpy/**/*.py)",
      "Write(/scripts/**/*.py)",
      "Write(/sdevpy/**/*.ipynb)"
    ],
    "allow": [
      "Agent(**)",
      "Bash",
      "Edit(/claude/**)",
      "Edit(//tmp/**)",
      "Edit(/.claude/skills/code-review/**)",
      "Edit(/.claude/skills/recommendations/**)",
      "Edit(/.claude/skills/test-review/**)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git status*)",
      "Read(**)",
      "Read(//tmp/**)",
      "Read(//private/tmp/**)",
      "Skill(**)",
      "Skill(keybindings-help)",
      "Skill(keybindings-help:*)",
      "Write(/claude/**)",
      "Write(//tmp/**)",
      "Write(//private/tmp/**)"
    ],
    "additionalDirectories": [
      "\\tmp",
      "/private/tmp"
    ]
  }
}
