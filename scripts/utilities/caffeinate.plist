<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>caffeinate</string>
    <!-- caffeinate -s: block system sleep while on power; screens can still turn off -->
    <key>ProgramArguments</key>
    <array><string>/usr/bin/caffeinate</string><string>-s</string></array>
    <!-- Start as soon as it is loaded, and restart it if it ever stops -->
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
</dict>
</plist>
